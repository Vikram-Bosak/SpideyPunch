# ============================================================
# Hollywood Movie Clips - 24h Upload Workflow (Environment)
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# ---- Google Drive (Clip source) ----
# Either set GOOGLE_APPLICATION_CREDENTIALS to a service account JSON file path
# OR set GOOGLE_DRIVE_SERVICE_ACCOUNT to the full JSON payload of a service account.
# Share the "Movie Clips" source folder with the service account email.
GOOGLE_DRIVE_SERVICE_ACCOUNT=

# ---- YouTube Upload (OAuth2) ----
# Follow the README "YouTube OAuth2" section to obtain a refresh token.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ---- Facebook Upload (Graph API) ----
# Page-scoped access token with pages_manage_posts + pages_read_engagement
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# ---- Discord Reporting ----
# Full webhook URL for the Discord channel that receives upload reports.
DISCORD_WEBHOOK_URL=

# ---- Optional: LLM SEO enrichment ----
# If you provide your own LLM API key, Agent 2 uses it to enrich SEO metadata.
# Otherwise a high-quality rule-based generator is used (works with no key).
USER_LLM_API_KEY=
USER_LLM_BASE_URL=https://api.deepseek.com/v1
USER_LLM_MODEL=deepseek-chat
